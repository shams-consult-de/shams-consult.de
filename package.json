{
  "name": "shams-studio-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:pdf": "node --experimental-strip-types scripts/generate-portfolio-pdf.mjs",
    "prepare:documents": "node --experimental-strip-types scripts/prepare-portal-documents.mjs",
    "build": "node --experimental-strip-types scripts/prepare-portal-documents.mjs && node --experimental-strip-types scripts/generate-portfolio-pdf.mjs && vite build && node --experimental-strip-types scripts/generate-static-routes.mjs",
    "build:dev": "vite build --mode development",
    "optimize:images": "node scripts/optimize-images.mjs",
    "preview": "vite preview",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.14.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0"
  }
}
